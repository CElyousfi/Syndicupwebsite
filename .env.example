# URL canonique du site (sans barre finale)
NEXT_PUBLIC_SITE_URL=https://syndicup.ma

# ── Meta (Facebook / Instagram) ─────────────────────────────────────────
# Gestionnaire d'événements → Sources de données → votre pixel/jeu de données → ID (15–16 chiffres)
NEXT_PUBLIC_META_PIXEL_ID=
# Paramètres de l'entreprise → Sécurité de la marque → Domaines → « Balise méta » : la valeur de content="…"
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# Gestionnaire d'événements → votre pixel → Paramètres → API Conversions → « Générer un jeton d'accès »
# SECRET : à mettre uniquement dans les variables d'environnement de l'hébergeur, jamais dans le dépôt.
META_CAPI_ACCESS_TOKEN=
# Facultatif : code de l'onglet « Tester les événements » (à vider après les tests)
META_TEST_EVENT_CODE=
